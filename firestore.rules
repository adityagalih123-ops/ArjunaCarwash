rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    // --- users ---
    // User boleh baca profil sendiri; admin boleh baca/tulis semua profil.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- products ---
    // Semua user login boleh baca (untuk kasir memilih produk).
    // Hanya admin yang boleh tambah/ubah/hapus master produk.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- transactions ---
    // Semua user login boleh baca & buat transaksi.
    // Transaksi tidak boleh diubah/dihapus (data histori keuangan harus utuh).
    match /transactions/{trxId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- shifts ---
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- settings (nama perusahaan, alamat, counter nomor transaksi) ---
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
